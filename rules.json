{
 "_readme": [
  "This file is the brain of the app. Edit it here or in the app's Rules tab.",
  "The merchant map ships EMPTY on purpose - merchant names are personal data and this",
  "repo is public. Load my-rules.json (kept off GitHub) once via the Rules tab and it",
  "lives in your browser from then on.",
  "merchants: exact statement description (without the city) -> category.",
  "alwaysReview: descriptions that should always land on the Review sheet for you to decide.",
  "spendCategoryDefaults: fallback for new merchants, using the bank's own spend category.",
  "gtaRule: meals outside the GTA become business travel.",
  "Anything the rules cannot settle goes to the Review sheet - it is never guessed silently."
 ],
 "version": 1,
 "fiscalYearEndMonth": 9,
 "fiscalFolderTemplate": "Annual Audit {fy} Sep",
 "driveRoot": [
  "Annual Audit {fy} Sep",
  "Credit Card Statements"
 ],
 "reviewCategory": "Review",
 "wave": {
  "_readme": [
   "Posting a finished quarter into Wave. anchorAccount is the account the cards",
   "are settled through - each category posts as a withdrawal on it, with the",
   "expense account as the line item.",
   "exclude: categories that are never posted. Personal spending is the company's",
   "business only in the sense that it must stay OUT of the company's books.",
   "accounts: workbook category -> EXACT Wave account name. A category missing",
   "from this map blocks posting rather than being dropped silently."
  ],
  "anchorAccount": "Shareholder Loan - Jeff Kaminker",
  "exclude": [
   "Personal",
   "Personal - Home Insurance"
  ],
  "accounts": {
   "Business Travel": "Business Travel",
   "Travel - Domestic": "Travel - Domestic",
   "Travel": "Business Travel",
   "Professional Fees": "Professional Fees",
   "Meals": "Meals and Entertainment",
   "Rent": "Rent Expense",
   "Office Supplies": "Office Supplies",
   "Office Equipment": "Office Supplies",
   "Phone": "Telephone – Wireless",
   "Fuel": "Vehicle – Fuel",
   "Health - Insurance": "Health Insurance - Greenfield"
  }
 },
 "highlightColor": [
  0.988,
  0.957,
  0.522
 ],
 "cards": {
  "amex": {
   "label": "Amex",
   "driveFolder": "Amex",
   "detect": [
    "American Express",
    "Aeroplan"
   ],
   "workbookName": "{quarter} Amex Transactions.xlsx",
   "categoryFileName": "Amex {quarter} {category}.pdf",
   "summaryFolder": "Expenses Summary",
   "statementsFolder": "Abridged Statements",
   "sheets": {
    "summary": "CAD EXP SUMMARY",
    "data": "CAD EXPENSES",
    "fx": "USD EXPENSES",
    "review": "Review"
   },
   "dataHeaders": [
    "Date",
    "Description",
    "Amount",
    "Category"
   ],
   "summaryHeaders": [
    "Row Labels",
    "Sum of Amount"
   ],
   "headerStyle": "blueText",
   "controlTotalLabel": "{date} statement - total new transactions"
  },
  "cibc": {
   "label": "CIBC",
   "driveFolder": "CIBC",
   "detect": [
    "CIBC",
    "Costco World Mastercard"
   ],
   "workbookName": "CIBC {quarter} Transactions.xlsx",
   "categoryFileName": "CIBC {quarter} {category}.pdf",
   "summaryFolder": "Expense Summary",
   "statementsFolder": "Abridged Statements",
   "sheets": {
    "summary": "Summary",
    "data": "Data",
    "review": "Review"
   },
   "dataHeaders": [
    "TRANSACTION DATE",
    "TRANSACTION DETAILS",
    "PERSONAL CATEGORIES",
    "AMOUNT"
   ],
   "summaryHeaders": [
    "Row Labels",
    "Sum of AMOUNT"
   ],
   "headerStyle": "blueFill",
   "controlTotalLabel": "{date} statement - total for card"
  },
  "rogers": {
   "label": "Rogers",
   "driveFolder": "Rogers",
   "detect": [
    "Rogers Bank",
    "rogersbank.com"
   ],
   "workbookName": "Rogers {quarter} Transactions.xlsx",
   "categoryFileName": "Rogers {quarter} {category}.pdf",
   "summaryFolder": "Expense Summary",
   "statementsFolder": "Abridged Statements",
   "sheets": {
    "summary": "Summary",
    "data": "CAD Expenses",
    "fx": "Travel",
    "review": "Review"
   },
   "dataHeaders": [
    "Date",
    "Merchant Name",
    "Category",
    "Amount"
   ],
   "summaryHeaders": [
    "Row Labels",
    "Sum of Amount"
   ],
   "headerStyle": "blueText",
   "gtaToCategory": "Travel",
   "controlTotalLabel": "{date} statement - new purchases, net of credits"
  }
 },
 "merchants": {
  "amex": {},
  "cibc": {},
  "rogers": {}
 },
